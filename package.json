{
  "name": "web-to-apk-platform",
  "version": "1.0.0",
  "description": "A platform to convert websites into APK files with dashboard analytics",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "dev-frontend": "cd frontend && npm start",
    "dev-backend": "cd backend && npm run dev",
    "deploy": "npm run build && vercel --prod",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "web-to-apk",
    "converter",
    "cordova",
    "webapp",
    "dashboard"
  ],
  "author": "Abhishek",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "archiver": "^6.0.1",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}